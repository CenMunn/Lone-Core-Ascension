# Copy to the exact path supplied to Settings.from_env; no key is committed.
# Process environment overrides ALL aliases in the file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# For Bailian text: set DEEPSEEK_BASE_URL to https://dashscope.aliyuncs.com/compatible-mode/v1
# and DEEPSEEK_MODEL to a model enabled in your account (e.g. deepseek-v3.2).
# BL_DEEPSEEK_API_KEY / BL_DEEPSEEK_BASE_URL / BL_DEEPSEEK_MODEL are also accepted.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MODEL=wanx2.1-t2i-turbo
# Leave empty for model default: 2.1=1024*1024; 2.5=1280*1280.
DASHSCOPE_IMAGE_SIZE=
API_TIMEOUT=60
